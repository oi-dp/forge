# general
abbr fe 'funced -e nvim'

# navigation
abbr .. 'cd ..'
abbr ... 'cd ../..'

# utilities
abbr mv 'mv -v'
abbr cp 'cp -v'
abbr bat 'bat -p'
abbr tree 'eza -aTL'

# docker
abbr dc docker-compose
abbr dcu 'docker-compose up -d'
abbr dcd 'docker-compose down'
abbr dce 'docker exec -it -u'

# git
abbr add 'git add'
abbr gc 'git commit'
abbr --set-cursor='%' gcm git\ commit\ -m\ \'\%\'
abbr push 'git push'
abbr pull 'git pull'
abbr gst 'git status'
abbr glog 'git log --oneline --graph --decorate'
abbr gco 'git checkout'

# tmux
abbr tat 'tmux attach -t'
abbr tls 'tmux ls'
abbr td 'tmux detach'
